{
  "uid": "jotra-server",
  "title": "Jotra server",
  "tags": ["jotra"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat",
      "title": "Players online",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum(jotra_players)" }]
    },
    {
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "refId": "A", "expr": "time() - max(jotra_start_time_seconds)" }]
    },
    {
      "type": "stat",
      "title": "Build",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "textMode": "name", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "jotra_build_info", "legendFormat": "{{build}} (protocol {{protocol}})" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Players",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0 } },
      "targets": [{ "refId": "A", "expr": "sum(jotra_players)", "legendFormat": "players" }]
    },
    {
      "type": "timeseries",
      "title": "Average tick time (budget 33 ms at 30 Hz, paused ticks not counted)",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(jotra_tick_seconds_total[$__rate_interval]) / rate(jotra_ticks_total[$__rate_interval])",
          "legendFormat": "tick"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bandwidth (ENet, all clients)",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "Bps", "min": 0 } },
      "targets": [
        { "refId": "A", "expr": "rate(jotra_sent_bytes_total[$__rate_interval])", "legendFormat": "sent" },
        { "refId": "B", "expr": "rate(jotra_received_bytes_total[$__rate_interval])", "legendFormat": "received" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Loaded chunks",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0 } },
      "targets": [{ "refId": "A", "expr": "sum(jotra_loaded_chunks)", "legendFormat": "chunks" }]
    },
    {
      "type": "timeseries",
      "title": "Last save duration",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "targets": [{ "refId": "A", "expr": "max(jotra_save_seconds)", "legendFormat": "save" }]
    },
    {
      "type": "timeseries",
      "title": "Enemies",
      "gridPos": { "x": 0, "y": 29, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0 } },
      "targets": [{ "refId": "A", "expr": "sum(jotra_enemies)", "legendFormat": "enemies" }]
    }
  ]
}
